{
  "name": "hive-platform",
  "version": "0.0.0",
  "private": true,
  "description": "HIVE: population-level security for autonomous agent estates.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.16.0 <23",
    "pnpm": ">=11.19.0 <12"
  },
  "scripts": {
    "console:dev": "pnpm --filter @hive/console dev",
    "console:build": "pnpm --filter @hive/console build",
    "console:check": "pnpm --filter @hive/console check",
    "console:test": "pnpm --filter @hive/console test",
    "console:e2e": "pnpm --filter @hive/console test:e2e",
    "check": "pnpm run console:check",
    "format:write": "pnpm --filter @hive/console format:write"
  }
}
